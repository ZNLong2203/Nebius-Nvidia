# --- Nebius Token Factory (required) -----------------------------------------
# Get a key at https://tokenfactory.nebius.com  ->  API keys
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Nebius Sandboxes / ConTree (required for the contree backend) -----------
# Same Nebius key works; the Sandboxes control plane lives on its own base URL.
CONTREE_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes
NEBIUS_PROJECT_ID=

# --- Tavily (optional, enables the docs-lookup tool) -------------------------
TAVILY_API_KEY=

# --- Behaviour ---------------------------------------------------------------
ARBORIST_BACKEND=contree          # contree | local
ARBORIST_BRANCHING=1              # 0 disables forking -> linear baseline agent
ARBORIST_FANOUT=4                 # candidate patches per expansion
ARBORIST_MAX_NODES=24             # hard cap on sandbox executions
ARBORIST_MAX_DEPTH=4
ARBORIST_TOKEN_BUDGET=1500000     # total tokens across all tiers
